{
  "name": "dku-campus-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "단국대 죽전캠퍼스 신입생용 시설 안내 모바일 웹(PWA)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-data.ts",
    "validate:strict": "tsx scripts/validate-data.ts --strict",
    "typecheck": "tsc -b",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-09-01"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0"
  }
}
