# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# VITE_ 로 시작하는 값은 브라우저 번들에 그대로 들어갑니다. 비밀 키는 절대 넣지 마세요.

# 오류 제보용 Google Form '미리 채워진 링크'. 장소 ID가 들어갈 자리에 {placeId} 를 적어 둡니다.
# 예: https://docs.google.com/forms/d/e/XXXXXXXX/viewform?usp=pp_url&entry.123456789={placeId}
VITE_REPORT_FORM_URL=
